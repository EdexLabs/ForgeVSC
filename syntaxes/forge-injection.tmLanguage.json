{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Forge Injection (JS/TS Template Literals)",
  "scopeName": "forge.injection",
  "injectionSelector": "L:source.js - comment, L:source.ts - comment, L:source.jsx - comment, L:source.tsx - comment, L:source.js.jsx - comment",
  "patterns": [
    {
      "include": "#forge-template-literal"
    }
  ],
  "repository": {
    "forge-template-literal": {
      "comment": "Matches code: `...`. The closing backtick cannot be escaped with a single \\.",
      "name": "meta.embedded.block.forge",
      "begin": "(code)\\s*(:)\\s*(`)",
      "beginCaptures": {
        "1": {
          "name": "meta.other.forge-code.js"
        },
        "2": {
          "name": "meta.punctuation.separator.key-value.js"
        },
        "3": {
          "name": "meta.string.template.begin.js"
        }
      },
      "end": "(?<!\\\\)(?:\\\\\\\\)*(`)",
      "endCaptures": {
        "1": {
          "name": "meta.string.template.end.js"
        }
      },
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#js-in-template"
        },
        {
          "include": "#function"
        }
      ]
    },
    "js-in-template": {
      "comment": "$djsEval[<js>] or $js[<js>] inside a backtick block — embed source.js so TextMate highlights the JS argument.",
      "name": "meta.function-call.js-eval.forge",
      "begin": "([!@#?&]*)(\\$)(djsEval|js)(\\[)",
      "beginCaptures": {
        "1": {
          "name": "meta.operator.modifier.forge"
        },
        "2": {
          "name": "meta.operator.dollar.forge"
        },
        "3": {
          "name": "meta.entity.function.forge"
        },
        "4": {
          "name": "meta.punctuation.arguments.begin.forge"
        }
      },
      "end": "\\]",
      "endCaptures": {
        "0": {
          "name": "meta.punctuation.arguments.end.forge"
        }
      },
      "contentName": "source.js",
      "patterns": [
        {
          "include": "source.js"
        }
      ]
    },
    "comment": {
      "name": "meta.comment.block.forge",
      "begin": "(\\$)(c|C)(\\[)",
      "beginCaptures": {
        "1": {
          "name": "meta.punctuation.comment.forge"
        },
        "2": {
          "name": "meta.punctuation.comment.forge"
        },
        "3": {
          "name": "meta.punctuation.comment.begin.forge"
        }
      },
      "end": "\\]",
      "endCaptures": {
        "0": {
          "name": "meta.punctuation.comment.end.forge"
        }
      },
      "patterns": [
        {
          "include": "#bracket-nested"
        }
      ]
    },
    "bracket-nested": {
      "begin": "\\[",
      "end": "\\]",
      "patterns": [
        {
          "include": "#bracket-nested"
        }
      ]
    },
    "function": {
      "name": "meta.function-call.forge",
      "begin": "([!@#?&]*)(\\$)([a-zA-Z_][a-zA-Z0-9_]*)(\\[)",
      "beginCaptures": {
        "1": {
          "name": "meta.operator.modifier.forge"
        },
        "2": {
          "name": "meta.operator.dollar.forge"
        },
        "3": {
          "name": "meta.entity.function.forge"
        },
        "4": {
          "name": "meta.punctuation.arguments.begin.forge"
        }
      },
      "end": "\\]",
      "endCaptures": {
        "0": {
          "name": "meta.punctuation.arguments.end.forge"
        }
      },
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#function"
        }
      ]
    }
  }
}